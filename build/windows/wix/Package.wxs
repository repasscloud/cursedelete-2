<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="CurseDelete"
      Manufacturer="RePassCloud"
      Version="__VERSION__"
      Language="1033"
      Scope="perMachine"
      UpgradeCode="A690B423-3227-47F0-B898-734A1606B704">

    <SummaryInformation
        Description="CurseDelete command-line file deletion utility"
        Manufacturer="RePassCloud" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of CurseDelete is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Public MSI properties:
        INSTALLFOLDER  - Override installation path.
        LICENSEFILE    - Absolute path to a signed licence file (offline, machine-wide).
        ACTIVATIONKEY  - Activation key for online activation (machine-wide).

      Example:
        msiexec /i CurseDelete.msi /qn INSTALLFOLDER="D:\Apps\CurseDelete" LICENSEFILE="C:\Deploy\cursedelete.license"
    -->
    <Property Id="LICENSEFILE" Secure="yes" />
    <Property Id="ACTIVATIONKEY" Hidden="yes" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="RePassCloudFolder" Name="RePassCloud">
        <Directory Id="INSTALLFOLDER" Name="CurseDelete">
          <Component Id="MainPayload" Guid="*">
            <File Id="CursdelExe" Source="__PAYLOAD_DIR__\cursdel.exe" KeyPath="yes" />
            <File Id="ReadmeFile" Source="__PAYLOAD_DIR__\README.md" />
            <File Id="ChangelogFile" Source="__PAYLOAD_DIR__\CHANGELOG.md" />
            <File Id="LicenseFile" Source="__PAYLOAD_DIR__\LICENSE" />

            <!-- Add the INSTALL DIRECTORY (not the exe itself) to machine PATH. -->
            <Environment
                Id="AddInstallFolderToMachinePath"
                Name="PATH"
                Action="set"
                Part="last"
                System="yes"
                Permanent="no"
                Value="[INSTALLFOLDER]" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="CurseDelete" Level="1">
      <ComponentRef Id="MainPayload" />
    </Feature>

    <!--
      Optional post-install licensing into the machine-wide licence store.
      Runs as SYSTEM; a licence problem never fails the install (Return=ignore).
      Hidden target keeps ACTIVATIONKEY out of MSI action logging.
    -->
    <SetProperty
        Id="InstallLicenseFile"
        Value="&quot;[#CursdelExe]&quot; license install --system &quot;[LICENSEFILE]&quot;"
        Before="InstallLicenseFile"
        Sequence="execute"
        Condition="NOT Installed AND LICENSEFILE &lt;&gt; &quot;&quot;" />

    <CustomAction
        Id="InstallLicenseFile"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixSilentExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <SetProperty
        Id="ActivateLicense"
        Value="&quot;[#CursdelExe]&quot; license activate --system &quot;[ACTIVATIONKEY]&quot;"
        Before="ActivateLicense"
        Sequence="execute"
        Condition="NOT Installed AND ACTIVATIONKEY &lt;&gt; &quot;&quot;" />

    <CustomAction
        Id="ActivateLicense"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixSilentExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore"
        HideTarget="yes" />

    <InstallExecuteSequence>
      <Custom
          Action="InstallLicenseFile"
          After="InstallFiles"
          Condition="NOT Installed AND LICENSEFILE &lt;&gt; &quot;&quot;" />
      <Custom
          Action="ActivateLicense"
          After="InstallLicenseFile"
          Condition="NOT Installed AND ACTIVATIONKEY &lt;&gt; &quot;&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
